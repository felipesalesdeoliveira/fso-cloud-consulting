<mxfile host="app.diagrams.net" modified="2026-09-23T17:50:00.000Z" agent="Codex" version="24.7.17"><diagram id="aws-static-frontend" name="Arquitetura AWS"><mxGraphModel dx="1600" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
  <mxCell id="title" value="Frontend com CDN, S3, TLS e domínio customizado" style="text;html=1;align=left;fontSize=28;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="60" y="35" width="750" height="45" as="geometry"/></mxCell><mxCell id="subtitle" value="Arquitetura segura para entrega global de uma SPA React" style="text;html=1;align=left;fontSize=15;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="60" y="78" width="650" height="30" as="geometry"/></mxCell>
  <mxCell id="aws" value="AWS Cloud" style="swimlane;html=1;rounded=1;startSize=48;fillColor=#FFFFFF;swimlaneFillColor=#232F3E;strokeColor=#64748B;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="260" y="145" width="1260" height="545" as="geometry"/></mxCell>
  <mxCell id="user" value="Usuário&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;navegador&lt;/font&gt;" style="shape=mxgraph.aws4.user;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#232F3E;strokeColor=none;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="315" width="90" height="105" as="geometry"/></mxCell>
  <mxCell id="route53" value="Amazon Route 53&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;DNS público • Alias&lt;/font&gt;" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#8C4FFF;strokeColor=none;fontSize=17;fontStyle=1;" vertex="1" parent="aws"><mxGeometry x="90" y="165" width="95" height="125" as="geometry"/></mxCell>
  <mxCell id="cloudfront" value="Amazon CloudFront&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;CDN global • HTTPS&lt;/font&gt;" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#8C4FFF;strokeColor=none;fontSize=17;fontStyle=1;" vertex="1" parent="aws"><mxGeometry x="500" y="165" width="105" height="125" as="geometry"/></mxCell>
  <mxCell id="s3group" value="S3 Bucket (PRIVADO) • Block Public Access" style="swimlane;html=1;rounded=1;startSize=50;fillColor=#FFF1F2;strokeColor=#EF4444;fontColor=#991B1B;fontStyle=1;fontSize=15;" vertex="1" parent="aws"><mxGeometry x="855" y="105" width="320" height="250" as="geometry"/></mxCell><mxCell id="s3" value="Amazon S3&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;index.html + assets&lt;/font&gt;" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#7AA116;strokeColor=none;fontSize=17;fontStyle=1;" vertex="1" parent="s3group"><mxGeometry x="110" y="85" width="100" height="125" as="geometry"/></mxCell>
  <mxCell id="acm" value="AWS Certificate Manager&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;TLS • us-east-1&lt;/font&gt;" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#DD344C;strokeColor=none;fontSize=16;fontStyle=1;" vertex="1" parent="aws"><mxGeometry x="505" y="350" width="95" height="125" as="geometry"/></mxCell>
  <mxCell id="cache" value="Cache HIT: CloudFront responde diretamente da edge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontColor=#6D28D9;fontStyle=1;fontSize=13;" vertex="1" parent="aws"><mxGeometry x="380" y="70" width="340" height="44" as="geometry"/></mxCell>
  <mxCell id="spa" value="SPA: 403 e 404 → /index.html com status 200" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#9A3412;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="725" width="650" height="60" as="geometry"/></mxCell><mxCell id="deploy" value="Deploy: build de produção → publicação dos artefatos no S3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontColor=#6D28D9;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="750" y="725" width="760" height="60" as="geometry"/></mxCell>
  <mxCell id="decisions" value="&lt;b&gt;Decisões de arquitetura&lt;/b&gt;&lt;br&gt;• Route 53 usa Alias no domínio raiz&lt;br&gt;• Bucket privado + OAC: acesso exclusivo pelo CloudFront&lt;br&gt;• HTTP redirecionado para HTTPS; cache na edge" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#475569;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="810" width="650" height="120" as="geometry"/></mxCell><mxCell id="behavior" value="&lt;b&gt;Cache e operação&lt;/b&gt;&lt;br&gt;• Assets com hash têm cache longo&lt;br&gt;• index.html mantém o nome e exige tratamento&lt;br&gt;• Invalidação seletiva preserva objetos válidos" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#475569;fontSize=14;" vertex="1" parent="1"><mxGeometry x="750" y="810" width="760" height="120" as="geometry"/></mxCell>
  <mxCell id="e1" value="1. GET domínio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontStyle=1;" edge="1" parent="1" source="user" target="route53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2. Alias A/AAAA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C4FFF;strokeWidth=2;endArrow=block;endFill=1;fontStyle=1;" edge="1" parent="aws" source="route53" target="cloudfront"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="3. Cache MISS • request assinado (OAC)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontStyle=1;" edge="1" parent="aws" source="cloudfront" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="anexa TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B42318;fontStyle=1;" edge="1" parent="aws" source="acm" target="cloudfront"><mxGeometry relative="1" as="geometry"/></mxCell>
